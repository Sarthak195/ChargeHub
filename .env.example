# ── Database ──────────────────────────────────────────────
POSTGRES_USER=chargehub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chargehub
DATABASE_URL=postgresql+asyncpg://chargehub:changeme@postgres:5432/chargehub

# ── Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── TP-Link / Tapo Credentials (used for local LAN control)
TAPO_USERNAME=your_tplink_email@example.com
TAPO_PASSWORD=your_tplink_password

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App Config ────────────────────────────────────────────
PRICE_PER_KWH=0.12          # USD per kWh billed to residents
POLL_INTERVAL_SECONDS=30    # How often to poll plugs for power
APP_ENV=development         # development | production
